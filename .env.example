# Stellar
STELLAR_NETWORK=testnet
STELLAR_RPC_URL=https://soroban-testnet.stellar.org
STELLAR_NETWORK_PASSPHRASE="Test SDF Network ; September 2015"
STELLAR_TREASURY_ADDRESS=
# Timeout (ms) for a single Stellar RPC query before it's treated as failed
TRANSACTION_QUERY_TIMEOUT=10000
# Max attempts (with exponential backoff) for a Stellar RPC query before giving up
MAX_RETRY_ATTEMPTS=3

# Contracts
PAYMENT_REGISTRY_CONTRACT_ID=
MERCHANT_VAULT_CONTRACT_ID=
ESCROW_CONTRACT_ID=
PAYMENT_SPLIT_CONTRACT_ID=
SUBSCRIPTION_CONTRACT_ID=
FEE_MANAGER_CONTRACT_ID=

# Database
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=lumina
DATABASE_PASSWORD=lumina_password
DATABASE_NAME=lumina

# Backend
PORT=4000
NODE_ENV=development

# Logging
LOG_LEVEL=debug
LOG_DIR=logs

# Error Tracking (Sentry)
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:4000

# Auth
JWT_SECRET=
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_SECRET=
JWT_REFRESH_EXPIRY=7d
JWT_REFRESH_EXPIRY_SECONDS=604800
BCRYPT_SALT_ROUNDS=10
TWO_FACTOR_APP_NAME=Lumina
FRONTEND_URL=http://localhost:3000
API_KEY_SALT=

# Exchange / Conversion
EXCHANGE_API_KEY=
PRICE_ORACLE_URL=
CONVERSION_FEE_BPS=50
PRICE_CACHE_TTL_SECONDS=60
COINGECKO_API_URL=https://api.coingecko.com/api/v3
BINANCE_API_URL=https://api.binance.com/api/v3
CHAINLINK_RPC_URL=
CHAINLINK_BTC_USD_FEED=
CHAINLINK_ETH_USD_FEED=
CHAINLINK_XLM_USD_FEED=
CHAINLINK_USDT_USD_FEED=
CHAINLINK_USDC_USD_FEED=

# Notifications
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=notifications@lumina.dev

# Ramp Service - Payment Providers
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_CONNECT_ACCOUNT_ID=
MOONPAY_API_KEY=
MOONPAY_WEBHOOK_SECRET=
BANXA_API_KEY=
BANXA_WEBHOOK_SECRET=

# Monitoring (Grafana) - Alertmanager reads its secrets from
# alertmanager/secrets/*, not from this file; see alertmanager/README.md.
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin

# Multi-Layer Caching
# L1 Cache (In-Memory)
L1_CACHE_MAX_SIZE=1000
L1_CACHE_DEFAULT_TTL=60

# L2 Cache (Redis)
L2_CACHE_DEFAULT_TTL=3600
REDIS_CLUSTER_ENABLED=false
REDIS_CLUSTER_NODES=localhost:6379

# L3 Cache (CDN)
L3_CACHE_ENABLED=false
L3_CACHE_PROVIDER=custom
L3_CACHE_DEFAULT_TTL=86400

# Cache Invalidation
CACHE_KEY_PREFIX=lumina
CACHE_KEY_VERSION=v1

# Cache Warmup
CACHE_WARMUP_ENABLED=true
CACHE_WARMUP_PATTERNS=merchant:config:*,payment:methods:*,exchange:rates:*
CACHE_WARMUP_SCHEDULE=0 * * * *
CACHE_WARMUP_MAX_CONCURRENT=10

# Predictive Cache
PREDICTIVE_CACHE_ENABLED=true
PREDICTIVE_CACHE_ANALYSIS_INTERVAL=300000
PREDICTIVE_CACHE_PRELOAD_THRESHOLD=60000

# CDN Providers (if L3 enabled)
CLOUDFLARE_ZONE_ID=
CLOUDFLARE_API_KEY=
AWS_CLOUDFRONT_DISTRIBUTION_ID=
CUSTOM_CDN_INVALIDATION_URL=

# OpenTelemetry Distributed Tracing
OTEL_SERVICE_NAME=lumina-backend
OTEL_SERVICE_VERSION=1.0.0
OTEL_ENVIRONMENT=development
OTEL_SAMPLING_RATIO=0.1
JAEGER_ENDPOINT=http://localhost:14268/api/traces
OTEL_LOG_LEVEL=info

# Cross-Chain Atomic Swaps
# 32 bytes of hex. Swap secrets are sealed with this key at rest; if it is unset
# the backend falls back to an ephemeral key and in-flight swaps cannot survive
# a restart. Generate with: openssl rand -hex 32
SWAP_SECRET_ENCRYPTION_KEY=
# How long the customer's source leg stays locked, and how long the merchant's
# Stellar leg stays claimable. The source value must exceed the target value by
# at least an hour, or swaps are rejected at initiation.
SWAP_SOURCE_TIMEOUT_SECONDS=86400
SWAP_TARGET_TIMEOUT_SECONDS=43200
# Soroban HTLC that pays merchants in USDC
STELLAR_HTLC_CONTRACT_ID=

# Ethereum leg
ETHEREUM_RPC_URL=
ETHEREUM_HTLC_ADDRESS=
ETHEREUM_SWAP_RECIPIENT=
# Leave unset to escrow the chain's native currency instead of an ERC-20
ETHEREUM_SWAP_TOKEN=
# Optional wei/gas ceiling above which discretionary claims wait for cheaper gas
ETHEREUM_MAX_GAS_PRICE=

# Polygon leg
POLYGON_RPC_URL=
POLYGON_HTLC_ADDRESS=
POLYGON_SWAP_RECIPIENT=
POLYGON_SWAP_TOKEN=
POLYGON_MAX_GAS_PRICE=

# Bitcoin leg. There is no contract to deploy — the HTLC is a redeem script.
BITCOIN_NETWORK=testnet
BITCOIN_SWAP_RECIPIENT_PUBKEY=
# Esplora-compatible explorer; defaults to Blockstream's public instance
BITCOIN_API_URL=
BITCOIN_MAX_GAS_PRICE=

# Solana leg
SOLANA_RPC_URL=
SOLANA_HTLC_PROGRAM_ID=
SOLANA_SWAP_RECIPIENT=
SOLANA_MAX_GAS_PRICE=

# WebSocket real-time events
WS_TOKEN_EXPIRY=5m
WS_RATE_LIMIT_PER_MINUTE=120
WS_MAX_CONNECTIONS_PER_USER=10
WS_OFFLINE_BUFFER_TTL_MS=300000
WS_EVENT_BATCH_MS=25
WS_EVENT_BATCH_MAX=50
WS_PUBLIC_URL=http://localhost:4000
